from __future__ import annotations

import io
import logging
import os
import time
from typing import Optional

import cv2
import numpy as np
from fastapi import APIRouter, Request, UploadFile, File, Form
from fastapi.responses import Response, StreamingResponse, JSONResponse, FileResponse

from src.engine.stream_manager import StreamManager
from src.engine.chatbot import SafetyChatbot

logger = logging.getLogger(__name__)
router = APIRouter()

# Global stream manager singleton
stream_manager = StreamManager(video_path="videos/test.mp4")
safety_chatbot = SafetyChatbot()


# ---------------------------------------------------------------------------
# Video stream
# ---------------------------------------------------------------------------

@router.get("/video_feed")
def video_feed():
    """Streams YOLO-processed frames as multipart/x-mixed-replace."""
    return StreamingResponse(
        stream_manager.generate_frames(),
        media_type="multipart/x-mixed-replace; boundary=frame",
        headers={
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Pragma": "no-cache",
            "Expires": "0",
        },
    )


# ---------------------------------------------------------------------------
# Dashboard HTML
# ---------------------------------------------------------------------------

@router.get("/dashboard")
def get_dashboard():
    """Serves the IronEye monitoring dashboard."""
    dashboard_path = os.path.join(
        os.path.dirname(os.path.dirname(__file__)), "static", "dashboard.html"
    )
    if os.path.exists(dashboard_path):
        return FileResponse(dashboard_path, media_type="text/html")
    return JSONResponse({"error": "Dashboard template not found"}, status_code=404)


# ---------------------------------------------------------------------------
# Phone camera page
# ---------------------------------------------------------------------------

@router.get("/phone")
def get_phone_camera_page():
    """Serves the mobile camera page for Android browsers."""
    phone_path = os.path.join(
        os.path.dirname(os.path.dirname(__file__)), "static", "phone_camera.html"
    )
    if os.path.exists(phone_path):
        return FileResponse(phone_path, media_type="text/html")
    return JSONResponse({"error": "Phone camera page not found"}, status_code=404)


# ---------------------------------------------------------------------------
# Monitoring control
# ---------------------------------------------------------------------------

@router.post("/api/start")
def start_monitoring():
    """Resume or start video monitoring."""
    stream_manager.start()
    return JSONResponse({
        "success": True,
        "message": "Monitoring started",
        "state": stream_manager.get_status(),
    })


@router.post("/api/stop")
def stop_monitoring():
    """Pause video monitoring."""
    stream_manager.stop()
    return JSONResponse({
        "success": True,
        "message": "Monitoring paused",
        "state": stream_manager.get_status(),
    })


@router.get("/api/status")
def get_status():
    """Get live stream status, detection metrics, and video source details."""
    return JSONResponse(stream_manager.get_status())


# ---------------------------------------------------------------------------
# Safety zone
# ---------------------------------------------------------------------------

@router.post("/api/set_zone")
def set_zone(payload: dict):
    """Set the safety-zone polygon used by the risk engine."""
    points = payload.get("points", [])

    if not isinstance(points, list) or len(points) < 3:
        return JSONResponse(
            {"success": False, "message": "A zone requires at least 3 points."},
            status_code=400,
        )

    try:
        polygon = [(int(point["x"]), int(point["y"])) for point in points]
    except (KeyError, TypeError, ValueError):
        return JSONResponse(
            {"success": False, "message": "Each point must contain numeric x and y values."},
            status_code=400,
        )

    stream_manager.zone_polygon = polygon

    return JSONResponse({
        "success": True,
        "message": "Safety zone updated.",
        "points": polygon,
    })


@router.delete("/api/clear_zone")
def clear_zone():
    """Remove the configured safety-zone polygon."""
    stream_manager.zone_polygon = None
    stream_manager.risk_engine.reset_confirmation()
    return JSONResponse({"success": True, "message": "Safety zone cleared."})


@router.get("/api/get_zone")
def get_zone():
    """Return the currently configured safety-zone polygon."""
    polygon = stream_manager.zone_polygon
    if polygon is None:
        return JSONResponse({"zone": None, "points": []})
    points = [{"x": p[0], "y": p[1]} for p in polygon]
    return JSONResponse({"zone": "configured", "points": points})


@router.post("/api/toggle_feature")
def toggle_feature(payload: dict):
    feature = payload.get("feature")
    enabled = payload.get("enabled", False)
    
    if feature == "helmet":
        stream_manager.helmet_detection_enabled = enabled
    elif feature == "ppe":
        stream_manager.ppe_detection_enabled = enabled
    elif feature == "restriction_zone":
        stream_manager.restriction_zone_enabled = enabled
    else:
        return JSONResponse({"success": False, "message": "Unknown feature"}, status_code=400)
        
    return JSONResponse({"success": True, "feature": feature, "enabled": enabled})

# ---------------------------------------------------------------------------
# Incidents & Export
# ---------------------------------------------------------------------------

@router.get("/api/incidents")
def get_incidents():
    """Return recent incidents from the in-memory buffer (last 50, newest first)."""
    return JSONResponse({"incidents": stream_manager.get_recent_incidents()})


@router.get("/api/incidents/export")
def export_incidents_csv():
    """Export recorded incidents as a downloadable CSV file."""
    import csv

    incidents = stream_manager.get_recent_incidents()
    output = io.StringIO()
    writer = csv.writer(output)
    writer.writerow(["Timestamp", "Type", "Risk Level", "Confidence", "Evidence Path", "Alert Sent", "Zone"])

    for inc in incidents:
        writer.writerow([
            inc.get("timestamp", ""),
            inc.get("type", ""),
            inc.get("risk_level", ""),
            inc.get("confidence", ""),
            inc.get("evidence_path", ""),
            inc.get("alert_sent", False),
            inc.get("zone", ""),
        ])

    csv_data = output.getvalue()
    return Response(
        content=csv_data,
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=ironeye_incidents.csv"},
    )


# ---------------------------------------------------------------------------
# Safety Assistant Chatbot
# ---------------------------------------------------------------------------

@router.post("/api/chatbot")
async def chatbot_endpoint(request: Request):
    """Safety assistant chatbot answering safety FAQs and live system status queries."""
    try:
        payload = await request.json()
    except Exception:
        payload = {}
    message = payload.get("message", "")
    response_data = safety_chatbot.answer_query(message, stream_manager=stream_manager)
    return JSONResponse(response_data)


# ---------------------------------------------------------------------------
# Phone camera frame upload
# ---------------------------------------------------------------------------

@router.post("/api/phone_frame")
async def receive_phone_frame(request: Request):
    """
    Accept a JPEG frame uploaded from the phone browser.

    The phone page POSTs raw JPEG body with Content-Type: image/jpeg.
    """
    try:
        body = await request.body()
        if not body:
            return JSONResponse({"error": "Empty frame body"}, status_code=400)

        arr = np.frombuffer(body, dtype=np.uint8)
        frame = cv2.imdecode(arr, cv2.IMREAD_COLOR)
        if frame is None:
            return JSONResponse({"error": "Could not decode frame"}, status_code=400)

        camera_id = request.headers.get("X-Camera-Id", "phone")
        stream_manager.inject_phone_frame(frame, camera_id=camera_id)

        return JSONResponse({"ok": True, "ts": time.time()})
    except Exception:
        logger.exception("Failed to receive phone frame.")
        return JSONResponse({"error": "Internal error"}, status_code=500)


@router.post("/api/phone_camera/enable")
def enable_phone_camera():
    """Switch the video feed to use incoming phone-camera frames."""
    stream_manager.switch_to_phone_camera(True)
    return JSONResponse({"success": True, "mode": "phone_camera"})


@router.post("/api/phone_camera/disable")
def disable_phone_camera():
    """Switch back to the video file source."""
    stream_manager.switch_to_phone_camera(False)
    return JSONResponse({"success": True, "mode": "video_file"})


# ---------------------------------------------------------------------------
# Risk engine telemetry
# ---------------------------------------------------------------------------

@router.get("/api/risk")
def get_risk():
    """Return latest frame risk result."""
    frr = stream_manager.latest_frame_risk
    if frr is None:
        return JSONResponse({"risk": None})
    return JSONResponse({"risk": frr.to_dict()})


# ---------------------------------------------------------------------------
# Model info
# ---------------------------------------------------------------------------

@router.get("/api/model_info")
def model_info():
    """Return info about the currently loaded detection model."""
    det = stream_manager.detector
    if det is None or not det.is_loaded:
        return JSONResponse({
            "loaded": False,
            "model_name": None,
            "class_names": {},
        })
    return JSONResponse({
        "loaded": True,
        "model_name": det.model_name,
        "class_names": dict(det.class_names),
        "conf_threshold": det.conf_threshold,
    })